---
import '../styles/global.css'
const { title: pageTitle = 'Tienda Loren | tecnología' } = Astro.props
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Tienda Loren tecnología: celulares, laptops, monitores y accesorios con atención por WhatsApp." />
    <title>{pageTitle.replace('electro.', 'Tienda Loren')}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <script>
      const revealItems = document.querySelectorAll('.reveal-on-scroll')
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries, currentObserver) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return
            entry.target.classList.add('is-visible')
            currentObserver.unobserve(entry.target)
          })
        }, { threshold: 0.12 })
        revealItems.forEach((item) => observer.observe(item))
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'))
      }
    </script>
  </body>
</html>
