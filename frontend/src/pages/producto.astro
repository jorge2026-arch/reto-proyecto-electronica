---
import MainLayout from '../layouts/MainLayout.astro'
import Header from '../components/Header.astro'
---
<MainLayout title="Producto | electro."><Header /><main class="container-electro py-12"><a href="/shop" class="font-bold text-electro-blue">← Volver a la tienda</a><div data-detail class="mt-8 grid min-h-80 place-items-center text-electro-muted">Cargando producto...</div></main></MainLayout>
<script>
  import { api } from '../lib/api'
  import { formatPrice } from '../lib/formatPrice'
  import { productImage } from '../lib/productImages'
  const target = document.querySelector('[data-detail]')
  const id = Number(new URLSearchParams(location.search).get('id'))
  try { if (!Number.isInteger(id) || id <= 0) throw new Error('Producto no válido'); const p = await api.product(id);  const price = formatPrice(p.precio); const message = encodeURIComponent(`Hola, quiero comprar el producto: ${p.modelo_producto}. Precio: ${price}.`); if (target) target.innerHTML = `<div class="flex h-80 items-center justify-center bg-slate-50"><img src="${productImage(p.identificador_producto, p.categoria, p.imagen_url)}" alt="${p.modelo_producto}" class="h-64 w-64 object-contain"></div><div class="py-8"><p class="uppercase tracking-widest text-electro-yellow-dark">${p.categoria}</p><h1 class="font-display mt-2 text-4xl font-bold text-electro-navy">${p.modelo_producto}</h1><p class="mt-5 text-3xl font-bold">${price}</p><p class="mt-3 text-electro-muted">${p.stock > 0 ? `${p.stock} unidades disponibles` : 'Producto agotado'}</p><a href="https://wa.me/59172365287?text=${message}" target="_blank" rel="noreferrer" class="mt-6 inline-block rounded-full bg-electro-yellow px-6 py-3 font-bold text-white">Comprar por WhatsApp</a></div>` } catch (error) { if (target) target.innerHTML = `<p class="text-red-600">${error instanceof Error ? error.message : 'Producto no encontrado'}</p>` }
</script>


