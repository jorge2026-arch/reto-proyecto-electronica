---
import MainLayout from '../layouts/MainLayout.astro'
import Header from '../components/Header.astro'
import LoginForm from '../components/LoginForm.astro'
---
<MainLayout title="Iniciar sesión | electro."><Header /><main class="container-electro flex min-h-[calc(100vh-170px)] items-center justify-center py-12"><section class="w-full max-w-md rounded-xl border border-slate-100 bg-white p-8 shadow-lg"><p class="mb-2 text-sm font-bold uppercase tracking-widest text-electro-yellow-dark">Área privada</p><h1 class="font-display mb-2 text-3xl font-bold text-electro-navy">Bienvenido de nuevo</h1><p class="mb-8 text-electro-muted">Inicia sesión para administrar los productos.</p><LoginForm /></section></main></MainLayout>
