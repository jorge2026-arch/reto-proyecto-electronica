---
import MainLayout from '../../../layouts/MainLayout.astro'
import Header from '../../../components/Header.astro'
---
<MainLayout title="Nuevo producto | electro."><Header /><main class="container-electro py-12"><div class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-bold uppercase tracking-widest text-electro-yellow-dark">Administración</p><h1 class="font-display text-4xl font-bold text-electro-navy">Nuevo producto</h1><p class="mt-2 text-electro-muted">Registra un producto desde esta interfaz independiente.</p></div><a href="/admin/productos" class="font-bold text-electro-blue">← Volver a productos</a></div><form data-new-form class="mx-auto mt-8 max-w-xl space-y-4 rounded-xl border border-slate-100 bg-white p-6 shadow-sm"><input name="modelo_producto" required placeholder="Modelo del producto" class="w-full rounded border border-slate-300 px-3 py-2" /><input name="precio" required type="number" min="0.01" step="0.01" placeholder="Precio en Bs." aria-label="Precio en bolivianos" class="w-full rounded border border-slate-300 px-3 py-2" /><input name="stock" required type="number" min="0" step="1" placeholder="Stock" class="w-full rounded border border-slate-300 px-3 py-2" /><select name="categoria" required class="w-full rounded border border-slate-300 bg-white px-3 py-2"><option value="">Categoría</option><option>celular</option><option>laptop</option><option>monitor</option><option>teclado</option><option>mouse</option><option>audifonos</option></select><input name="imagen_url" type="url" placeholder="URL de imagen (opcional)" aria-label="URL opcional de imagen del producto" class="w-full rounded border border-slate-300 px-3 py-2" /><p data-new-message class="min-h-5 text-sm text-red-600"></p><div class="flex gap-2"><button class="flex-1 rounded bg-electro-yellow px-4 py-2 font-bold">Guardar producto</button><a href="/admin/productos" class="rounded border px-4 py-2 font-bold">Cancelar</a></div></form></main></MainLayout>
<script>
  import { api } from '../../../lib/api'
  import { productSchema } from '../../../lib/schemas'
  import { requireSession } from '../../../lib/session'

  requireSession()
  const form = document.querySelector('[data-new-form]') as HTMLFormElement | null
  const message = document.querySelector('[data-new-message]')

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    const parsed = productSchema.safeParse(Object.fromEntries(new FormData(form)))
    if (!parsed.success) { if (message) message.textContent = parsed.error.issues[0]?.message ?? 'Revisa los datos'; return }
    try {
      await api.createProduct(parsed.data)
      window.location.href = '/admin/productos'
    } catch (error) {
      if (message) message.textContent = error instanceof Error ? error.message : 'No se pudo guardar el producto'
    }
  })
</script>
